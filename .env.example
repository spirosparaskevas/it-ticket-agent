# Copy to .env and fill in your key: cp .env.example .env   (never commit .env)
# Every other setting is in agent.toml.

# --- Model ---
# Provider; Supported: openai or gemini.
LLM_PROVIDER=openai
# The model id.
LLM_MODEL=gpt-6-luna
# Reasoning level for models that support this parameter (leave it blank for models without reasoning eg. gpt-4o-mini)
LLM_REASONING=none


# --- Keys: only for the providers you use ---
OPENAI_API_KEY=

# GEMINI_API_KEY=

# ---------------------------------------------------------------------------------------------------------------------

# OPTIONAL - fallback models, tried in order only when the model above is unavailable:
# LLM_FALLBACK_MODELS=gemini/gemini-3.5-flash@low

# Optional: send the openai provider to another OpenAI-compatible endpoint, e.g. Amazon Bedrock
# (with a Bedrock API key in OPENAI_API_KEY) or a platform LLM gateway.
# OPENAI_BASE_URL=

# --- Ticketing API ---
# TICKETING_API_KEY=